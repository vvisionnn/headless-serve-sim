{
  "name": "headless-serve-sim-binary",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build:swift": "./build.sh",
    "test:adaptive": "DEVELOPER_DIR=$(xcode-select -p) swiftc Sources/SimStreamHelper/AdaptiveController.swift scripts/adaptive-controller-selftest.swift -o /tmp/adaptive-selftest && /tmp/adaptive-selftest",
    "test:metrics": "swiftc Sources/SimStreamHelper/ProcessMetrics.swift scripts/process-metrics-selftest.swift -o /tmp/process-metrics-selftest && /tmp/process-metrics-selftest",
    "test:snapshot": "swiftc Sources/SimStreamHelper/FrameSnapshotter.swift scripts/frame-snapshot-selftest.swift -o /tmp/frame-snapshot-selftest && /tmp/frame-snapshot-selftest",
    "test:frame-admission": "swiftc Sources/SimStreamHelper/FrameAdmissionController.swift scripts/frame-admission-selftest.swift -o /tmp/frame-admission-selftest && /tmp/frame-admission-selftest",
    "test:stream-format": "swiftc Sources/SimStreamHelper/StreamFormat.swift scripts/stream-format-selftest.swift -o /tmp/stream-format-selftest && /tmp/stream-format-selftest",
    "test:keyframe-request": "swiftc Sources/SimStreamHelper/KeyframeRequest.swift scripts/keyframe-request-selftest.swift -o /tmp/keyframe-request-selftest && /tmp/keyframe-request-selftest",
    "test:avcc-send-queue": "swiftc Sources/SimStreamHelper/AVCCSendQueue.swift scripts/avcc-send-queue-selftest.swift -o /tmp/avcc-send-queue-selftest && /tmp/avcc-send-queue-selftest",
    "test:hid-usage": "swiftc Sources/SimStreamHelper/HIDUsage.swift scripts/hid-usage-selftest.swift -o /tmp/hid-usage-selftest && /tmp/hid-usage-selftest",
    "test:developer-dir": "swiftc Sources/SimStreamHelper/DeveloperDir.swift scripts/developer-dir-selftest.swift -o /tmp/developer-dir-selftest && /tmp/developer-dir-selftest",
    "test:frame-display": "swiftc Sources/SimStreamHelper/FrameDisplaySelector.swift Sources/SimStreamHelper/FrameDisplayMonitor.swift scripts/frame-display-selector-selftest.swift -o /tmp/frame-display-selector-selftest && /tmp/frame-display-selector-selftest",
    "test:frame-capture": "swiftc Sources/SimStreamHelper/FrameDisplaySelector.swift Sources/SimStreamHelper/FrameDisplayProperties.swift Sources/SimStreamHelper/FrameCapture.swift scripts/frame-capture-selftest.swift -o /tmp/frame-capture-selftest && /tmp/frame-capture-selftest",
    "test:client-manager": "swiftc -D SWIFTER_STUB -emit-library -emit-module -module-name Swifter scripts/client-manager-selftest.swift -o /tmp/libSwifter.dylib && swiftc -I /tmp -L /tmp -lSwifter Sources/SimStreamHelper/ClientManager.swift Sources/SimStreamHelper/Protocol.swift Sources/SimStreamHelper/StreamFormat.swift Sources/SimStreamHelper/AVCCSendQueue.swift scripts/client-manager-selftest.swift -o /tmp/client-manager-selftest && DYLD_LIBRARY_PATH=/tmp /tmp/client-manager-selftest",
    "test:hid-touch-target": "swiftc Sources/SimStreamHelper/HIDTouchTarget.swift scripts/hid-touch-target-selftest.swift -o /tmp/hid-touch-target-selftest && /tmp/hid-touch-target-selftest",
    "test:hid-display-input": "swiftc Sources/SimStreamHelper/HIDDisplayInput.swift scripts/hid-display-input-selftest.swift -o /tmp/hid-display-input-selftest && /tmp/hid-display-input-selftest",
    "test:jpeg-composition": "swiftc Sources/SimStreamHelper/JPEGComposition.swift Sources/SimStreamHelper/VideoEncoder.swift scripts/jpeg-composition-selftest.swift -o /tmp/jpeg-composition-selftest && /tmp/jpeg-composition-selftest",
    "test:duo-output": "swiftc -O -parse-as-library -framework VideoToolbox Sources/SimStreamHelper/DuoOutput.swift Sources/SimStreamHelper/FrameScaler.swift scripts/duo-output-selftest.swift -o /tmp/duo-output-selftest && /tmp/duo-output-selftest",
    "test:duo-motion": "swiftc -O -parse-as-library Sources/SimStreamHelper/DuoMotion.swift scripts/duo-motion-selftest.swift -o /tmp/duo-motion-selftest && /tmp/duo-motion-selftest",
    "test:duo-frame-pump": "swiftc -O -parse-as-library Sources/SimStreamHelper/DuoMotion.swift Sources/SimStreamHelper/DuoOutput.swift Sources/SimStreamHelper/DuoFramePump.swift scripts/duo-frame-pump-selftest.swift -o /tmp/duo-frame-pump-selftest && /tmp/duo-frame-pump-selftest",
    "test:duo-renderer": "swiftc -O -swift-version 6 -warnings-as-errors -parse-as-library Sources/SimStreamHelper/DuoRenderer.swift Sources/SimStreamHelper/DuoShellMaterials.swift scripts/duo-renderer-selftest.swift -o /tmp/duo-renderer-selftest && /tmp/duo-renderer-selftest",
    "test:raw-panel-renderer": "swiftc -O -swift-version 6 -warnings-as-errors -parse-as-library Sources/SimStreamHelper/RawPanelRenderer.swift scripts/raw-panel-renderer-selftest.swift -o /tmp/raw-panel-renderer-selftest && /tmp/raw-panel-renderer-selftest",
    "test:h264-color": "swiftc -O -parse-as-library Sources/SimStreamHelper/H264Encoder.swift Sources/SimStreamHelper/StreamFormat.swift Sources/SimStreamHelper/DuoOutput.swift scripts/h264-color-selftest.swift -o /tmp/h264-color-selftest && /tmp/h264-color-selftest",
    "test:device-motion-consumer": "xcrun clang -fobjc-arc -framework Foundation -framework IOKit scripts/device-motion-consumer-selftest.m -o /tmp/device-motion-consumer-selftest && /tmp/device-motion-consumer-selftest",
    "test:swift": "for t in adaptive metrics snapshot frame-admission stream-format keyframe-request avcc-send-queue hid-usage developer-dir scroll-drag h264-pump frame-scaler frame-display frame-capture client-manager hid-touch-target hid-display-input jpeg-composition duo-output duo-motion duo-frame-pump duo-renderer raw-panel-renderer h264-color device-motion-consumer; do echo \"--- $t\"; bun run \"test:$t\" || exit 1; done",
    "test:scroll-drag": "swiftc Sources/SimStreamHelper/ScrollDrag.swift scripts/scroll-drag-selftest.swift -o /tmp/scroll-drag-selftest && /tmp/scroll-drag-selftest",
    "test:h264-pump": "swiftc Sources/SimStreamHelper/H264Pump.swift scripts/h264-pump-selftest.swift -o /tmp/h264-pump-selftest && /tmp/h264-pump-selftest",
    "test:frame-scaler": "swiftc -framework VideoToolbox Sources/SimStreamHelper/FrameScaler.swift scripts/frame-scaler-selftest.swift -o /tmp/frame-scaler-selftest && /tmp/frame-scaler-selftest"
  }
}
